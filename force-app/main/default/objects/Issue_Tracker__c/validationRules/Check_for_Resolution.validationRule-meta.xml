<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_for_Resolution</fullName>
    <active>true</active>
    <errorConditionFormula>AND (RecordType.Name = &apos;Rollback Request&apos;,ISPICKVAL(Status__c, &apos;Resolved&apos;), Resolution__c = NULL)</errorConditionFormula>
    <errorDisplayField>Resolution__c</errorDisplayField>
    <errorMessage>Please Update the Resolution.</errorMessage>
</ValidationRule>
