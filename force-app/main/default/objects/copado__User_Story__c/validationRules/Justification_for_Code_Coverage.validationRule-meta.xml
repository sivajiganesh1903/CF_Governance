<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Justification_for_Code_Coverage</fullName>
    <active>true</active>
    <errorConditionFormula>AND( Apex_Code_Coverage_Exception__c =true , ISBLANK( Justification_for_Coverage__c ) )</errorConditionFormula>
    <errorDisplayField>Justification_for_Coverage__c</errorDisplayField>
    <errorMessage>Justification shouldn&apos;t be blank if apex code coverage exception is provided.</errorMessage>
</ValidationRule>
